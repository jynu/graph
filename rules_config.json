{
  "version": "1.0",
  "description": "Business rules for training data column selection",
  "rules": {
    "distinct_count_thresholds": {
      "small_enum_threshold": 100,
      "large_enum_threshold": 10000,
      "rejection_threshold": 50000
    },
    "column_type_rules": {
      "string": {
        "max_length": 1000,
        "allow_enums": true
      },
      "integer": {
        "allow_enums": true
      },
      "float": {
        "allow_enums": false,
        "precision_required": true
      },
      "timestamp": {
        "allow_enums": false,
        "date_range_required": true
      },
      "nestedtype": {
        "allow_enums": false,
        "special_handling": true
      }
    },
    "table_specific_rules": {
      "trade_tables": {
        "required_columns": ["trade_id", "trade_date", "instrument_id"],
        "priority_columns": ["quantity", "price", "amount", "currency"]
      },
      "position_tables": {
        "required_columns": ["position_id", "as_of_date"],
        "priority_columns": ["market_value", "book_value", "quantity"]
      },
      "risk_tables": {
        "required_columns": ["risk_id", "calculation_date"],
        "priority_columns": ["var_amount", "stress_test_result"]
      }
    },
    "exclusion_rules": {
      "exclude_patterns": [
        ".*_temp$",
        ".*_backup$",
        ".*_archive$",
        "test_.*"
      ],
      "exclude_column_types": [
        "blob",
        "clob",
        "binary"
      ]
    },
    "performance_rules": {
      "max_processing_time_minutes": 60,
      "max_distinct_values_to_fetch": 50000,
      "query_timeout_seconds": 300
    }
  },
  "decision_matrix": {
    "COLUMNS_NEEDBA_EVAL": {
      "distinct_count_max": 100,
      "description": "Columns with low cardinality suitable for enumeration",
      "fetch_distinct_values": true,
      "include_in_training": true
    },
    "COLUMNS_NOTREJALLPHASE_NEEDBA_EVAL": {
      "distinct_count_min": 101,
      "distinct_count_max": 10000,
      "description": "Columns with medium cardinality requiring business analysis",
      "fetch_distinct_values": true,
      "include_in_training": true
    },
    "COLUMNS_REJECTED": {
      "distinct_count_min": 10001,
      "description": "Columns with high cardinality rejected from training",
      "fetch_distinct_values": false,
      "include_in_training": false
    }
  }
}